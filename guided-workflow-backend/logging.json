{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "uvicorn.logging.DefaultFormatter",
      "fmt": "%(levelprefix)-7s %(message)s",
      "use_colors": null
    },
    "access": {
      "()": "api.log_utils.ApiAccessFormatter",
      "fmt": "%(asctime)s.%(msecs)03d | %(client_addr)s | %(user)s | \"%(request_line)s\" %(status_code)s"
    },
    "snowflake": {
      "()": "api.log_utils.ApiFormatter",
      "fmt": "%(asctime)s.%(msecs)03d | %(user)s | %(message)s"
    },
    "api": {
      "()": "api.log_utils.ApiFormatter",
      "fmt": "%(asctime)s.%(msecs)03d | %(user)s | %(message)s"
    }
  },
  "filters": {
    "no_healthcheck": {
      "()": "api.log_utils.exclude_routes_filter",
      "routes": [
        "/healthcheck"
      ]
    },
    "snowflake_queries": {
      "()": "api.log_utils.SnowflakeQueryFilter"
    },
    "user_name": {
      "()": "api.log_utils.UserNameFilter"
    }
  },
  "handlers": {
    "default": {
      "formatter": "default",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr"
    },
    "access": {
      "formatter": "access",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    },
    "api": {
      "formatter": "api",
        "class": "logging.StreamHandler",
        "stream": "ext://sys.stdout"
    },
    "queries": {
      "formatter": "snowflake",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": [
        "default"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO"
    },
    "uvicorn.access": {
      "handlers": [
        "access"
      ],
      "level": "INFO",
      "propagate": false,
      "filters": [
        "user_name",
        "no_healthcheck"
      ]
    },
    "api": {
      "handlers": [
        "api"
      ],
      "filters": [
        "user_name"
      ],
      "level": "INFO",
      "propagate": false
    },
    "snowflake.connector.cursor": {
      "level": "DEBUG",
      "handlers": [
        "queries"
      ],
      "filters": [
        "snowflake_queries",
        "user_name"
      ],
      "propagate": false
    },
    "root": {
      "level": "WARNING",
      "handlers": [
        "default"
      ]
    }
  }
}
